let current = 0;
let answers = new Array(QUESTIONS.length).fill(null);
let score = 0;

function startQuiz() {
  showScreen('screen-quiz');
  renderQuestion(0);
  updateNav();
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}

function renderQuestion(idx) {
  const q = QUESTIONS[idx];
  const answered = answers[idx] !== null;
  const container = document.getElementById('quiz-container');

  // Update progress
  const answered_count = answers.filter(a => a !== null).length;
  document.getElementById('prog-label').textContent = `Question ${idx+1} of ${QUESTIONS.length}`;
  document.getElementById('prog-frac').textContent = `${answered_count} / ${QUESTIONS.length}`;
  document.getElementById('prog-fill').style.width = ((idx+1)/QUESTIONS.length*100)+'%';
  document.getElementById('nav-score').textContent = score + ' pts';

  const cardClass = answered
    ? (answers[idx] === q.ans ? 'answered-correct' : 'answered-wrong')
    : '';

  container.innerHTML = `
    <div class="q-card ${cardClass}">
      <div class="q-header">
        <div class="q-num">${String(idx+1).padStart(2,'0')}</div>
        <span class="q-topic-badge ${q.tc}">${q.topic}</span>
      </div>
      <div class="q-text">${q.q}</div>
      <div class="options">
        ${q.opts.map((opt, i) => {
          let cls = '';
          if (answered) {
            if (i === q.ans) cls = 'correct';
            else if (i === answers[idx] && answers[idx] !== q.ans) cls = 'wrong';
          }
          const keys = ['A','B','C','D'];
          return `<button class="opt-btn ${cls}" ${answered?'disabled':''} onclick="selectAnswer(${i})">
            <span class="opt-key">${keys[i]}</span>${opt}
          </button>`;
        }).join('')}
      </div>
      <div class="explanation ${answered ? (answers[idx]===q.ans?'correct':'wrong') : ''} ${answered?'show':''}">
        ${answered ? (answers[idx]===q.ans ? '✓ Correct! ' : '✗ Incorrect. ') + q.exp : ''}
      </div>
    </div>
  `;

  // Show/hide finish button
  const allDone = answers.filter(a=>a!==null).length === QUESTIONS.length;
  document.getElementById('btn-finish').style.display = allDone ? 'block' : 'none';
  document.getElementById('btn-prev').disabled = idx === 0;
  document.getElementById('btn-next').disabled = idx === QUESTIONS.length-1;
}

function selectAnswer(choice) {
  if (answers[current] !== null) return;
  answers[current] = choice;
  if (choice === QUESTIONS[current].ans) score++;
  document.getElementById('nav-score').textContent = score + ' pts';
  renderQuestion(current);

  // Auto-advance after 1.2s
  setTimeout(() => {
    if (current < QUESTIONS.length - 1) {
      current++;
      renderQuestion(current);
      updateNav();
    } else {
      document.getElementById('btn-finish').style.display = 'block';
    }
  }, 1200);
}

function navigate(dir) {
  current = Math.max(0, Math.min(QUESTIONS.length-1, current+dir));
  renderQuestion(current);
  updateNav();
}

function updateNav() {
  document.getElementById('btn-prev').disabled = current === 0;
  document.getElementById('btn-next').disabled = current === QUESTIONS.length-1;
}

function showResults() {
  const correct = answers.filter((a,i) => a === QUESTIONS[i].ans).length;
  const wrong = answers.filter((a,i) => a !== null && a !== QUESTIONS[i].ans).length;
  const skip = answers.filter(a => a === null).length;
  const pct = Math.round(correct/QUESTIONS.length*100);

  document.getElementById('score-big').textContent = correct;
  document.getElementById('res-correct').textContent = correct;
  document.getElementById('res-wrong').textContent = wrong;
  document.getElementById('res-skip').textContent = skip;

  let grade, msg, color;
  if(pct >= 90) { grade='A+'; msg='Outstanding! You have mastered continuous distributions.'; color='var(--green)'; }
  else if(pct >= 80) { grade='A'; msg='Excellent! Strong understanding of all topics.'; color='var(--green)'; }
  else if(pct >= 70) { grade='B'; msg='Good work! Review a few weak areas.'; color='var(--cyan)'; }
  else if(pct >= 60) { grade='C'; msg='Average. Revisit the lecture notes carefully.'; color='var(--amber)'; }
  else if(pct >= 50) { grade='D'; msg='Below average. Focus on fundamentals.'; color='var(--amber)'; }
  else { grade='F'; msg='Needs improvement. Re-read the entire lecture.'; color='var(--red)'; }

  document.getElementById('grade-letter').textContent = grade;
  document.getElementById('grade-letter').style.color = color;
  document.getElementById('grade-msg').textContent = msg;
  document.getElementById('score-ring').style.borderColor = color;
  document.getElementById('score-big').style.color = color;
  document.getElementById('res-sub').textContent = `// You scored ${pct}% — ${correct} out of ${QUESTIONS.length} correct`;

  const banner = document.getElementById('grade-banner');
  banner.style.background = color.replace(')', ',0.08)').replace('var(', 'rgba(').replace('--green','34,211,160').replace('--cyan','0,229,255').replace('--amber','251,191,36').replace('--red','244,63,94');
  banner.style.border = `1px solid ${color.replace(')', ',0.3)').replace('var(', 'rgba(').replace('--green','34,211,160').replace('--cyan','0,229,255').replace('--amber','251,191,36').replace('--red','244,63,94')}`;

  showScreen('screen-results');
}

function retryQuiz() {
  answers = new Array(QUESTIONS.length).fill(null);
  score = 0;
  current = 0;
  showScreen('screen-quiz');
  renderQuestion(0);
  updateNav();
  document.getElementById('btn-finish').style.display = 'none';
}

function reviewQuiz() {
  current = 0;
  showScreen('screen-quiz');
  renderQuestion(0);
  updateNav();
}
</script>
