    opts:["≈ 2.9654","≈ 0.06","≈ 20","≈ 3.0"],
    ans:0, exp:"μ = ln(20²/√(20²+25)) = ln(400/√425) ≈ ln(19.41) ≈ 2.9654." },

  { topic:"Lognormal", tc:"tc-lognorm",
    q:"Given μ_L=20 and σ²_L=25, compute σ² for the lognormal:",
    opts:["≈ 0.06","≈ 2.9654","≈ 25","≈ 400"],
