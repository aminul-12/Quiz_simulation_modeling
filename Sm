<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulation & Modelling — 100 MCQ Quiz</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #05080f;
  --surface: #0c1220;
  --card: #111b2e;
  --border: #1c2d47;
  --cyan: #00e5ff;
  --violet: #8b5cf6;
  --green: #22d3a0;
  --amber: #fbbf24;
  --red: #f43f5e;
  --text: #e2e8f0;
  --muted: #4a6080;
  --mono: 'IBM Plex Mono', monospace;
  --sans: 'Space Grotesk', sans-serif;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  min-height: 100vh;
}
body::before {
  content:'';
  position:fixed;
  inset:0;
  background:
    radial-gradient(ellipse 60% 40% at 20% 10%, rgba(0,229,255,0.04) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 80% 80%, rgba(139,92,246,0.05) 0%, transparent 60%);
  pointer-events:none;
  z-index:0;
}

/* ── SCREEN MANAGER ── */
.screen { display:none; position:relative; z-index:1; }
.screen.active { display:block; }

/* ── HERO / START ── */
#screen-start {
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px 20px;
}
.hero {
  max-width:680px;
  width:100%;
  text-align:center;
}
.hero-eyebrow {
  font-family:var(--mono);
  font-size:0.72rem;
  color:var(--cyan);
  letter-spacing:3px;
  text-transform:uppercase;
  margin-bottom:20px;
  opacity:0.8;
}
.hero h1 {
  font-size:clamp(2rem,6vw,3.4rem);
  font-weight:700;
  line-height:1.08;
  letter-spacing:-1.5px;
  margin-bottom:16px;
}
.hero h1 em {
  font-style:normal;
  background: linear-gradient(120deg, var(--cyan), var(--violet));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}
.hero-sub {
  font-size:0.95rem;
  color:var(--muted);
  line-height:1.7;
  margin-bottom:40px;
  font-family:var(--mono);
}
.topics-grid {
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(140px,1fr));
  gap:10px;
  margin-bottom:40px;
}
.topic-chip {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:8px;
  padding:10px 12px;
  font-family:var(--mono);
  font-size:0.68rem;
  color:var(--muted);
  text-align:left;
  line-height:1.5;
}
.topic-chip span {
  display:block;
  font-size:0.75rem;
  font-weight:700;
  margin-bottom:3px;
}
.topic-chip.t1 span { color:var(--cyan); }
.topic-chip.t2 span { color:var(--violet); }
.topic-chip.t3 span { color:var(--green); }
.topic-chip.t4 span { color:var(--amber); }
.topic-chip.t5 span { color:var(--red); }
.topic-chip.t6 span { color:#f472b6; }
.topic-chip.t7 span { color:#34d399; }
.topic-chip.t8 span { color:#a78bfa; }
.topic-chip.t9 span { color:#fb923c; }

.btn-start {
  background: linear-gradient(135deg, var(--cyan), var(--violet));
  color: var(--bg);
  border:none;
  border-radius:10px;
  padding:16px 48px;
  font-family:var(--sans);
  font-size:1rem;
  font-weight:700;
  cursor:pointer;
  letter-spacing:-0.3px;
  transition: transform 0.15s, box-shadow 0.15s;
  box-shadow: 0 0 30px rgba(0,229,255,0.2);
}
.btn-start:hover { transform:translateY(-2px); box-shadow:0 0 40px rgba(0,229,255,0.35); }

.stat-row {
  display:flex;
  justify-content:center;
  gap:32px;
  margin-bottom:36px;
}
.stat { text-align:center; }
.stat-num { font-size:2rem; font-weight:700; color:var(--cyan); font-family:var(--mono); }
.stat-lbl { font-size:0.68rem; color:var(--muted); font-family:var(--mono); text-transform:uppercase; letter-spacing:1px; }

/* ── QUIZ SCREEN ── */
#screen-quiz { min-height:100vh; padding:0; }
.quiz-layout {
  max-width:820px;
  margin:0 auto;
  padding:30px 20px 100px;
}

/* Progress bar */
.progress-bar-wrap {
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(5,8,15,0.92);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
  padding:12px 20px;
}
.progress-meta {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:8px;
  max-width:820px;
  margin-left:auto;
  margin-right:auto;
}
.progress-label { font-family:var(--mono); font-size:0.72rem; color:var(--muted); }
.progress-frac { font-family:var(--mono); font-size:0.85rem; font-weight:700; color:var(--cyan); }
.progress-track {
  max-width:820px;
  margin:0 auto;
  height:4px;
  background:var(--border);
  border-radius:2px;
  overflow:hidden;
}
.progress-fill {
  height:100%;
  background:linear-gradient(90deg, var(--cyan), var(--violet));
  border-radius:2px;
  transition:width 0.4s ease;
}

/* Question card */
.q-card {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:16px;
  padding:30px;
  margin-top:28px;
  transition:border-color 0.3s;
}
.q-card.answered-correct { border-color: rgba(34,211,160,0.5); }
.q-card.answered-wrong   { border-color: rgba(244,63,94,0.4); }

.q-header {
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:20px;
}
.q-num {
  width:36px; height:36px;
  border-radius:8px;
  background:rgba(0,229,255,0.1);
  border:1.5px solid rgba(0,229,255,0.3);
  color:var(--cyan);
  font-family:var(--mono);
  font-size:0.8rem;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}
.q-topic-badge {
  font-family:var(--mono);
  font-size:0.62rem;
  padding:3px 9px;
  border-radius:20px;
  border:1px solid;
}
.q-text {
  font-size:1rem;
  font-weight:500;
  line-height:1.65;
  margin-bottom:22px;
  color:var(--text);
}

/* Options */
.options { display:flex; flex-direction:column; gap:10px; }
.opt-btn {
  background: rgba(255,255,255,0.02);
  border: 1.5px solid var(--border);
  border-radius:10px;
  padding:13px 16px;
  color:var(--text);
  font-family:var(--sans);
  font-size:0.88rem;
  text-align:left;
  cursor:pointer;
  transition: all 0.15s;
  display:flex;
  align-items:flex-start;
  gap:12px;
  line-height:1.5;
}
.opt-btn:hover:not(:disabled) {
  background:rgba(0,229,255,0.06);
  border-color:rgba(0,229,255,0.4);
}
.opt-key {
  width:24px; height:24px;
  border-radius:5px;
  background:rgba(255,255,255,0.05);
  border:1px solid var(--border);
  font-family:var(--mono);
  font-size:0.7rem;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  color:var(--muted);
}
.opt-btn.correct {
  background:rgba(34,211,160,0.1);
  border-color:var(--green);
  color:var(--green);
}
.opt-btn.correct .opt-key { background:rgba(34,211,160,0.2); border-color:var(--green); color:var(--green); }
.opt-btn.wrong {
  background:rgba(244,63,94,0.08);
  border-color:var(--red);
  color:var(--red);
  opacity:0.8;
}
.opt-btn.wrong .opt-key { background:rgba(244,63,94,0.15); border-color:var(--red); color:var(--red); }
.opt-btn:disabled { cursor:default; }

/* Explanation */
.explanation {
  margin-top:16px;
  padding:14px 16px;
  border-radius:10px;
  font-family:var(--mono);
  font-size:0.75rem;
  line-height:1.6;
  display:none;
}
.explanation.correct { background:rgba(34,211,160,0.07); border:1px solid rgba(34,211,160,0.25); color:var(--green); }
.explanation.wrong   { background:rgba(244,63,94,0.06); border:1px solid rgba(244,63,94,0.2); color:#fb7185; }
.explanation.show { display:block; }

/* Floating nav */
.q-nav {
  position:fixed;
  bottom:24px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  align-items:center;
  gap:12px;
  background:rgba(12,18,32,0.92);
  backdrop-filter:blur(16px);
  border:1px solid var(--border);
  border-radius:50px;
  padding:10px 20px;
  z-index:200;
}
.nav-btn {
  background:var(--card);
  border:1px solid var(--border);
  color:var(--text);
  padding:8px 18px;
  border-radius:30px;
  font-family:var(--sans);
  font-size:0.8rem;
  font-weight:600;
  cursor:pointer;
  transition:all 0.15s;
}
.nav-btn:hover { border-color:var(--cyan); color:var(--cyan); }
.nav-btn.primary {
  background:linear-gradient(135deg,var(--cyan),var(--violet));
  color:var(--bg);
  border:none;
}
.nav-btn:disabled { opacity:0.3; cursor:not-allowed; }
.nav-score {
  font-family:var(--mono);
  font-size:0.8rem;
  color:var(--cyan);
  min-width:60px;
  text-align:center;
}

/* ── RESULTS SCREEN ── */
#screen-results {
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px 20px;
}
.results-wrap { max-width:700px; width:100%; }
.results-title {
  font-size:clamp(1.8rem,5vw,3rem);
  font-weight:700;
  letter-spacing:-1px;
  margin-bottom:8px;
  text-align:center;
}
.results-sub {
  font-family:var(--mono);
  font-size:0.78rem;
  color:var(--muted);
  text-align:center;
  margin-bottom:40px;
}
.score-ring-wrap {
  display:flex;
  justify-content:center;
  margin-bottom:40px;
}
.score-ring {
  width:180px; height:180px;
  border-radius:50%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  border:4px solid var(--border);
  position:relative;
}
.score-big { font-size:2.6rem; font-weight:700; font-family:var(--mono); }
.score-denom { font-family:var(--mono); font-size:0.78rem; color:var(--muted); }
.results-stats {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
  margin-bottom:28px;
}
.res-stat {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:12px;
  padding:18px;
  text-align:center;
}
.res-stat-num { font-size:1.8rem; font-weight:700; font-family:var(--mono); margin-bottom:4px; }
.res-stat-lbl { font-size:0.68rem; color:var(--muted); font-family:var(--mono); text-transform:uppercase; letter-spacing:1px; }

.grade-banner {
  border-radius:14px;
  padding:20px 24px;
  text-align:center;
  margin-bottom:28px;
}
.grade-letter { font-size:3rem; font-weight:700; font-family:var(--mono); }
.grade-msg { font-size:0.9rem; color:var(--muted); margin-top:6px; }

.results-btns { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
.btn-retry {
  background:var(--card);
  border:1.5px solid var(--border);
  color:var(--text);
  padding:12px 28px;
  border-radius:10px;
  font-family:var(--sans);
  font-size:0.9rem;
  font-weight:600;
  cursor:pointer;
  transition:all 0.15s;
}
.btn-retry:hover { border-color:var(--cyan); color:var(--cyan); }
.btn-review {
  background:linear-gradient(135deg,var(--cyan),var(--violet));
  color:var(--bg);
  border:none;
  padding:12px 28px;
  border-radius:10px;
  font-family:var(--sans);
  font-size:0.9rem;
  font-weight:700;
  cursor:pointer;
  transition:transform 0.15s;
}
.btn-review:hover { transform:translateY(-2px); }

/* Topic colors */
.tc-uniform  { color:#00e5ff; border-color:rgba(0,229,255,0.35); }
.tc-expo     { color:#8b5cf6; border-color:rgba(139,92,246,0.35); }
.tc-gamma    { color:#22d3a0; border-color:rgba(34,211,160,0.35); }
.tc-erlang   { color:#fbbf24; border-color:rgba(251,191,36,0.35); }
.tc-normal   { color:#f43f5e; border-color:rgba(244,63,94,0.35); }
.tc-weibull  { color:#f472b6; border-color:rgba(244,114,182,0.35); }
.tc-tri      { color:#34d399; border-color:rgba(52,211,153,0.35); }
.tc-lognorm  { color:#a78bfa; border-color:rgba(167,139,250,0.35); }
.tc-beta     { color:#fb923c; border-color:rgba(251,146,60,0.35); }

@media(max-width:500px) {
  .results-stats { grid-template-columns:1fr 1fr; }
  .topics-grid { grid-template-columns:1fr 1fr; }
}
</style>
</head>
<body>

<!-- ════════════ START SCREEN ════════════ -->
<div class="screen active" id="screen-start">
  <div class="hero">
    <div class="hero-eyebrow">Simulation &amp; Modelling · Lecture 9-10</div>
    <h1>100 MCQ<br><em>Practice Quiz</em></h1>
    <p class="hero-sub">// Continuous Distributions — Test your knowledge</p>

    <div class="stat-row">
      <div class="stat"><div class="stat-num">100</div><div class="stat-lbl">Questions</div></div>
      <div class="stat"><div class="stat-num">9</div><div class="stat-lbl">Topics</div></div>
      <div class="stat"><div class="stat-num">∞</div><div class="stat-lbl">Attempts</div></div>
    </div>

    <div class="topics-grid">
      <div class="topic-chip t1"><span>Uniform</span>pdf, cdf, mean, variance</div>
      <div class="topic-chip t2"><span>Exponential</span>λ, memoryless, CDF</div>
      <div class="topic-chip t3"><span>Gamma</span>Γ function, parameters</div>
      <div class="topic-chip t4"><span>Erlang</span>k-phases, queueing</div>
      <div class="topic-chip t5"><span>Normal</span>Z-score, Φ table</div>
      <div class="topic-chip t6"><span>Weibull</span>shape, reliability</div>
      <div class="topic-chip t7"><span>Triangular</span>mode, median</div>
      <div class="topic-chip t8"><span>Lognormal</span>parameters, mean</div>
      <div class="topic-chip t9"><span>Beta</span>range, flexibility</div>
    </div>

    <button class="btn-start" onclick="startQuiz()">Start Quiz →</button>
  </div>
</div>

<!-- ════════════ QUIZ SCREEN ════════════ -->
<div class="screen" id="screen-quiz">
  <div class="progress-bar-wrap">
    <div class="progress-meta">
      <span class="progress-label" id="prog-label">Question 1 of 100</span>
      <span class="progress-frac" id="prog-frac">0 / 100</span>
    </div>
    <div class="progress-track"><div class="progress-fill" id="prog-fill" style="width:0%"></div></div>
  </div>

  <div class="quiz-layout" id="quiz-container"></div>

  <div class="q-nav">
    <button class="nav-btn" id="btn-prev" onclick="navigate(-1)">← Prev</button>
    <span class="nav-score" id="nav-score">0 pts</span>
    <button class="nav-btn" id="btn-next" onclick="navigate(1)">Next →</button>
    <button class="nav-btn primary" id="btn-finish" onclick="showResults()" style="display:none">Finish 🎯</button>
  </div>
</div>

<!-- ════════════ RESULTS SCREEN ════════════ -->
<div class="screen" id="screen-results">
  <div class="results-wrap">
    <div class="results-title">Quiz Complete!</div>
    <div class="results-sub" id="res-sub">// Results for Simulation &amp; Modelling MCQ</div>

    <div class="score-ring-wrap">
      <div class="score-ring" id="score-ring">
        <div class="score-big" id="score-big">0</div>
        <div class="score-denom" id="score-denom">/ 100</div>
      </div>
    </div>

    <div class="results-stats">
      <div class="res-stat">
        <div class="res-stat-num" style="color:var(--green)" id="res-correct">0</div>
        <div class="res-stat-lbl">Correct</div>
      </div>
      <div class="res-stat">
        <div class="res-stat-num" style="color:var(--red)" id="res-wrong">0</div>
        <div class="res-stat-lbl">Wrong</div>
      </div>
      <div class="res-stat">
        <div class="res-stat-num" style="color:var(--muted)" id="res-skip">0</div>
        <div class="res-stat-lbl">Skipped</div>
      </div>
    </div>

    <div class="grade-banner" id="grade-banner">
      <div class="grade-letter" id="grade-letter">A</div>
      <div class="grade-msg" id="grade-msg">Excellent work!</div>
    </div>

    <div class="results-btns">
      <button class="btn-retry" onclick="retryQuiz()">↺ Retry Quiz</button>
      <button class="btn-review" onclick="reviewQuiz()">Review Answers</button>
    </div>
  </div>
</div>

<script>
const QUESTIONS = [
  // ── UNIFORM DISTRIBUTION (Q1–Q15) ──
  { topic:"Uniform", tc:"tc-uniform",
    q:"What is the PDF of a Uniform distribution on interval (a, b)?",
    opts:["f(x) = 1/(b−a) for a ≤ x ≤ b","f(x) = λe^(−λx) for x ≥ 0","f(x) = (b−a)²/12","f(x) = (a+b)/2"],
    ans:0, exp:"The Uniform PDF is 1/(b−a) over [a,b] and 0 elsewhere — equal probability density across the interval." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"The mean of a Uniform distribution Unif(a, b) is:",
    opts:["(a+b)/2","(b−a)²/12","1/λ","(a+b+c)/3"],
    ans:0, exp:"E(X) = (a+b)/2 — the midpoint of the interval, by symmetry." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"The variance of Unif(a, b) is:",
    opts:["(b−a)²/12","(a+b)/2","(b−a)/2","(b−a)²/6"],
    ans:0, exp:"V(X) = (b−a)²/12. The variance grows with the square of the interval width." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"The CDF of Unif(a, b) for a ≤ x ≤ b is:",
    opts:["(x−a)/(b−a)","(b−a)/x","x/(b−a)","1 − e^(−λx)"],
    ans:0, exp:"F(x) = (x−a)/(b−a), which linearly increases from 0 to 1 as x goes from a to b." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"If X ~ Unif(50, 150), what is P{80 < X < 120}?",
    opts:["0.4","0.5","0.3","0.6"],
    ans:0, exp:"P = (120−80)/(150−50) = 40/100 = 0.4." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"For the Uniform distribution, what role does it play in simulation?",
    opts:["Generates random numbers between 0 and 1 for random events","Models component failure rates","Describes normal phenomena","Models queueing arrivals"],
    ans:0, exp:"Uniform(0,1) random numbers are the foundation for generating all other distributions in simulation." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"P(x₁ < X < x₂) for Unif(a,b) is proportional to:",
    opts:["Length of interval (x₂−x₁)","Value of x₁","Value of x₂","The midpoint (x₁+x₂)/2"],
    ans:0, exp:"For a uniform distribution, probability is proportional to interval length: (x₂−x₁)/(b−a)." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"If a bus arrives every 20 min and a passenger arrives uniformly in (0,30), what is P(wait > 5 min)?",
    opts:["5/6","1/6","1/2","2/3"],
    ans:0, exp:"Waiting >5 min means arriving in (0,15) or (20,30) — total 25 out of 30 minutes = 5/6." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"For Unif(α, β), what is the height of the PDF rectangle?",
    opts:["1/(β−α)","(β−α)","(α+β)/2","(β−α)²/12"],
    ans:0, exp:"The PDF is constant at 1/(β−α) for the entire interval [α, β]." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"X ~ Unif(1, 6). What is the mean?",
    opts:["3.5","2.5","4","3"],
    ans:0, exp:"E(X) = (1+6)/2 = 7/2 = 3.5" },

  { topic:"Uniform", tc:"tc-uniform",
    q:"X ~ Unif(1, 6). What is the variance?",
    opts:["25/12","5/2","5","1/12"],
    ans:0, exp:"V(X) = (6−1)²/12 = 25/12 ≈ 2.083" },

  { topic:"Uniform", tc:"tc-uniform",
    q:"The CDF F(x) = 0 when:",
    opts:["x < a","x > b","x = (a+b)/2","a ≤ x ≤ b"],
    ans:0, exp:"F(x) = 0 for x < a (below the lower bound), 1 for x ≥ b." },

  { topic:"Uniform", tc:"tc-uniform",
    q:"The shape of the PDF graph for Unif(α, β) is:",
    opts:["A rectangle (flat line)","A bell curve","An exponentially decaying curve","A triangle"],
    ans:0, exp:"The PDF is a horizontal line (rectangle) at height 1/(β−α) between α and β." },

  { topic:"Uniform", tc:"tc-uniform",
